# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y completa con los valores reales

# ═══════════════════════════════════════════════════════════════
# 100ms Configuration (NEW - V2 Video Calls)
# ═══════════════════════════════════════════════════════════════
# Get these from your 100ms dashboard: https://dashboard.100ms.live

# Template ID for creating rooms
HMS_TEMPLATE_ID=your_template_id_here

# Management token for server-side operations
HMS_MANAGEMENT_TOKEN=your_management_token_here

# App Access Key
HMS_APP_ACCESS_KEY=your_app_access_key_here

# App Secret (keep this secure!)
HMS_APP_SECRET=your_app_secret_here

# Workspace ID
HMS_WORKSPACE_ID=your_workspace_id_here

# ═══════════════════════════════════════════════════════════════
# Legacy Agora Configuration (TO BE DEPRECATED)
# ═══════════════════════════════════════════════════════════════

# Agora Configuration (LEGACY - will be removed after migration)
AGORA_APP_ID=your_agora_app_id_here

# ═══════════════════════════════════════════════════════════════
# Firebase Configuration (opcional - pueden usar Remote Config como fallback)
# ═══════════════════════════════════════════════════════════════

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ═══════════════════════════════════════════════════════════════
# Otros servicios sensibles
# ═══════════════════════════════════════════════════════════════

# API_ENDPOINT_URL=https://api.example.com
# SECRET_KEY=your_secret_key_here

# IMPORTANTE:
# - NUNCA commits el archivo .env al repositorio
# - Usa valores reales solo en .env (no en .env.example)
# - El archivo .env debe estar en .gitignore