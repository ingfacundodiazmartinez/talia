rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función global para verificar si un usuario es admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Usuarios
    match /users/{userId} {
      // 🔒 SEGURIDAD: Función para verificar si existe chat entre usuarios
      // El chatId tiene formato: {sortedUserId1}_{sortedUserId2}
      function hasChatWith() {
        let chatId = request.auth.uid < userId ?
          request.auth.uid + '_' + userId : userId + '_' + request.auth.uid;
        return exists(/databases/$(database)/documents/chats/$(chatId));
      }

      // 🔒 SEGURIDAD: Función para verificar si existe contacto entre usuarios
      // El contactId tiene formato: {sortedUserId1}_{sortedUserId2}
      // Permite leer datos de usuarios con contacto pendiente/aprobado
      function hasContactWith() {
        let contactId = request.auth.uid < userId ?
          request.auth.uid + '_' + userId : userId + '_' + request.auth.uid;
        return exists(/databases/$(database)/documents/contacts/$(contactId));
      }

      // 🔒 SEGURIDAD: Función para verificar relación padre-hijo usando parent_children
      function isParentOrChildRelation() {
        return exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + userId)) ||
               exists(/databases/$(database)/documents/parent_children/$(userId + '_' + request.auth.uid));
      }

      // 🔒 SEGURIDAD: Función para verificar si el padre puede ver este usuario
      // porque es contacto de alguno de sus hijos
      // Usa campo denormalizado contactedByChildOf en el documento del usuario
      function isContactOfMyChild() {
        return request.auth.uid in resource.data.get('contactedByChildOf', []);
      }

      // 🔒 SEGURIDAD: Solo puedes leer usuarios si:
      // 1. Es tu propio perfil, O
      // 2. Existe un chat entre ambos (se crea al aprobar contacto), O
      // 3. Existe un contacto entre ambos (pendiente o aprobado), O
      // 4. Hay relación padre-hijo, O
      // 5. Es contacto de alguno de tus hijos (para ver fotos/nombres frescos)
      // Nota: La búsqueda por código usa Cloud Function findUserByCode
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        hasChatWith() ||
        hasContactWith() ||
        isParentOrChildRelation() ||
        isContactOfMyChild()
      );

      // CREAR: Solo puede crear su propio usuario Y sin campos sensibles
      allow create: if request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['isAdmin']);

      // Función auxiliar para verificar si solo se actualizan campos premium
      function isUpdatingOnlyPremiumFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Campos premium que solo Cloud Functions pueden modificar
        return changedKeys.hasOnly([
          'isPremium',
          'subscriptionTier',
          'premiumExpiresAt',
          'subscriptionType',
          'subscriptionId',
          'subscriptionAutoRenew',
          'updatedAt'
        ]);
      }

      // Función auxiliar para verificar si el usuario autenticado es padre del userId
      function isParentOfUser() {
        let parentDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return parentDoc.data.linkedChildrenIds != null &&
               userId in parentDoc.data.linkedChildrenIds;
      }

      // Función auxiliar para verificar si solo se actualizan campos de moderación
      function isUpdatingOnlyModerationFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(['moderatingUserIds', 'moderationLevels']);
      }

      // ACTUALIZAR: Solo puede actualizar SU PROPIO usuario Y sin tocar campos sensibles
      // NOTA: Los campos premium (isPremium, subscriptionTier, etc.) están protegidos
      allow update: if request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin',
          'role',
          'isPremium',
          'subscriptionTier',
          'premiumExpiresAt',
          'subscriptionType',
          'subscriptionId',
          'subscriptionAutoRenew'
        ]);

      // Padres pueden actualizar campos de moderación en sus hijos vinculados
      allow update: if isParentOfUser() && isUpdatingOnlyModerationFields();

      // Solo ADMINS pueden modificar isAdmin
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdmin']);

      // Dispositivos del usuario
      match /devices/{deviceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Datos privados del usuario (heartbeat, lastSeen, etc.)
      match /_private/{docId} {
        // Solo el usuario puede leer y escribir sus datos privados
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Favoritos del usuario (índice para consultas eficientes)
      match /favorites/{favoriteId} {
        // Solo el usuario puede leer y escribir sus propios favoritos
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false; // Solo crear/eliminar, no actualizar
      }
    }

    // Parent-children relationships
    match /parent_children/{docId} {
      // Permitir leer si el usuario está involucrado (para docs individuales y queries)
      // Esto permite tanto .get() como .snapshots()
      allow read: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // Solo Cloud Functions pueden crear vínculos
      allow create: if false;

      // Permitir actualizar solo si eres el padre o el hijo del vínculo
      allow update: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // Solo el padre puede eliminar (desvincular) a un hijo
      allow delete: if request.auth != null &&
        resource.data.parentId == request.auth.uid;
    }

    // Parent-child links (nueva colección para vínculos padre-hijo)
    match /parentChildLinks/{docId} {
      // Permitir leer si el usuario está involucrado (para docs individuales y queries)
      // Esto permite tanto .get() como .snapshots()
      allow read: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // Solo Cloud Functions pueden crear vínculos
      allow create: if false;

      // Permitir actualizar solo si eres el padre o el hijo del vínculo
      allow update: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // Solo el padre puede eliminar (desvincular) a un hijo
      allow delete: if request.auth != null &&
        resource.data.parentId == request.auth.uid;
    }

    // Chats
    match /chats/{chatId} {
      // 🔒 SEGURIDAD: Verificar si el usuario es padre de algún participante del chat
      // Verifica en parent_children usando el formato parentId_childId
      // NOTA: Esta función asume chats de 2 participantes (1 a 1)
      function isParentOfParticipant() {
        // Primero intentar con campo desnormalizado (más rápido, 0 lecturas)
        let hasDenormalized = resource.data.approvedParentViewers != null &&
                              request.auth.uid in resource.data.approvedParentViewers;

        // Si no hay campo desnormalizado, verificar en parent_children directamente
        // Extraer los participantes (asumiendo array de 2 elementos)
        let participants = resource.data.participants;
        let p1 = participants[0];
        let p2 = participants[1];

        // Verificar si el usuario actual es padre de p1 o p2
        // Verificamos ambas direcciones del ID por consistencia
        let isParentOfP1 = exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + p1)) ||
                           exists(/databases/$(database)/documents/parent_children/$(p1 + '_' + request.auth.uid));
        let isParentOfP2 = exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + p2)) ||
                           exists(/databases/$(database)/documents/parent_children/$(p2 + '_' + request.auth.uid));

        return hasDenormalized || isParentOfP1 || isParentOfP2;
      }

      // Permitir leer si:
      // 1. Eres participante del chat, O
      // 2. Eres padre aprobado (via campo desnormalizado approvedParentViewers)
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        isParentOfParticipant()
      );

      // 🔒 SEGURIDAD CRÍTICA: Solo Cloud Functions pueden crear chats
      // Los clientes DEBEN usar la Cloud Function `createChat` que valida:
      // - Contactos aprobados
      // - Bloqueos
      // - Restricciones parentales
      // - Rate limiting
      allow create: if false;

      // Función auxiliar para verificar si solo se están actualizando campos de archivado
      function isUpdatingOnlyArchiveFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Permitir archived_userId y archivedAt_userId donde userId es el usuario actual
        return changedKeys.hasOnly(['archived_' + request.auth.uid, 'archivedAt_' + request.auth.uid]);
      }

      // Función auxiliar para verificar si solo se está actualizando el contador de no leídos
      function isUpdatingOnlyUnreadCount() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Permitir unreadCount_userId donde userId es el usuario actual
        return changedKeys.hasOnly(['unreadCount_' + request.auth.uid]);
      }

      // Función auxiliar para verificar si se están actualizando campos de moderación
      function isUpdatingModerationFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasAny(['moderationEnabled', 'moderationParentId', 'moderationEnabledAt', 'moderationLevel']);
      }

      // 🔒 FUNCIÓN DE SEGURIDAD: Verificar si se están actualizando campos críticos que solo Cloud Functions pueden modificar
      function isUpdatingCriticalChatFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // EXCEPCIÓN: Permitir actualización de lastMessage SI NO hay moderación activa
        let chatHasModeration = resource.data.get('moderationEnabled', false) == true;

        // Si hay moderación: bloquear lastMessage*, Si NO hay moderación: solo bloquear moderationEnabled
        return chatHasModeration ?
          changedKeys.hasAny(['lastMessage', 'lastMessageTime', 'lastMessageSender', 'lastMessageAt']) :
          changedKeys.hasAny(['moderationEnabled']);
      }

      // Permitir actualizar si:
      // 1. El usuario es participante Y NO está tocando campos críticos Y NO está tocando campos de moderación, O
      // 2. El usuario es padre de uno de los participantes Y solo está actualizando campos de moderación/bloqueo, O
      // 3. El usuario es participante Y solo está actualizando sus propios campos de archivado, O
      // 4. El usuario es participante Y solo está actualizando su propio contador de no leídos
      // 🔒 NUEVO: Prohibir actualización de lastMessage, lastMessageTime, lastMessageSender desde frontend
      allow update: if request.auth != null && !isUpdatingCriticalChatFields() && (
        (request.auth.uid in resource.data.participants && !isUpdatingModerationFields()) ||
        (isParentOfParticipant() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'moderationEnabled', 'moderationParentId', 'moderationEnabledAt', 'moderationLevel',
           'isBlocked', 'blockedAt', 'blockedBy', 'unblockedAt', 'unblockedBy', 'lastActivity',
           'updatedAt', 'participants'
         ])) ||
        (request.auth.uid in resource.data.participants && isUpdatingOnlyArchiveFields()) ||
        (request.auth.uid in resource.data.participants && isUpdatingOnlyUnreadCount())
      );

      match /messages/{messageId} {
        // 🔒 SEGURIDAD: Verificar permisos para leer mensajes
        // Combina verificación de participante y padre aprobado
        function canReadMessages() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          // Es participante directo?
          let isParticipant = request.auth.uid in chatDoc.data.participants;

          // Es padre aprobado? (usa campo desnormalizado primero, luego parent_children)
          let hasDenormalized = chatDoc.data.approvedParentViewers != null &&
                                request.auth.uid in chatDoc.data.approvedParentViewers;

          // Si no hay desnormalizado, verificar en parent_children
          let participants = chatDoc.data.participants;
          let p1 = participants[0];
          let p2 = participants[1];
          let isParentOfP1 = exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + p1)) ||
                             exists(/databases/$(database)/documents/parent_children/$(p1 + '_' + request.auth.uid));
          let isParentOfP2 = exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + p2)) ||
                             exists(/databases/$(database)/documents/parent_children/$(p2 + '_' + request.auth.uid));

          let isApprovedParent = hasDenormalized || isParentOfP1 || isParentOfP2;
          return isParticipant || isApprovedParent;
        }

        // Función auxiliar: es participante? (para writes)
        function isParticipant() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          return request.auth.uid in chatDoc.data.participants;
        }

        // Permitir leer mensajes si eres participante o padre aprobado
        allow get: if request.auth != null && canReadMessages();

        // Permitir listar mensajes si eres participante o padre aprobado
        allow list: if request.auth != null && canReadMessages();

        // Función auxiliar para verificar si es un mensaje de llamada
        function isCallMessage() {
          return request.resource.data.type == 'missed_call' ||
                 request.resource.data.type == 'answered_call';
        }

        // ✅ FUNCIÓN: Verificar si el chat es válido para enviar mensajes
        // 🔒 SEGURIDAD: También verifica si el chat está bloqueado (isBlocked)
        function isChatValid() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          // Verificar que el chat NO esté bloqueado
          let notBlocked = !chatDoc.data.keys().hasAny(['isBlocked']) || chatDoc.data.isBlocked != true;
          // Si no existe el campo isValidChat, asumimos true (compatibilidad con chats viejos)
          // Si existe, debe ser true
          let isValid = !chatDoc.data.keys().hasAny(['isValidChat']) || chatDoc.data.isValidChat == true;
          // El chat es válido SOLO si no está bloqueado Y es válido
          return notBlocked && isValid;
        }

        // 🔒 FUNCIÓN: Verificar si el chat tiene moderación activa
        function chatHasModeration() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          return chatDoc.data.get('moderationEnabled', false) == true;
        }

        // 🔒 FUNCIÓN: Validar campos requeridos del mensaje
        function hasRequiredMessageFields() {
          return request.resource.data.keys().hasAll(['senderId', 'timestamp', 'type']) &&
                 request.resource.data.senderId == request.auth.uid;
        }

        // 🔒 SEGURIDAD CRÍTICA: Validación completa para crear mensajes
        // Permitir crear mensaje SOLO si:
        // 1. Eres el sender (senderId == auth.uid), Y
        // 2. Eres PARTICIPANTE del chat (validado en Firestore), Y
        // 3. El chat es VÁLIDO (isValidChat = true o no existe), Y
        // 4. El texto no excede 5000 caracteres, Y
        // 5. Si hay moderación, NO se permite escritura directa (debe usar Cloud Function)
        // 6. O es un mensaje de llamada Y eres participante Y chat válido
        allow create: if request.auth != null && isParticipant() && isChatValid() && hasRequiredMessageFields() && (
          (request.auth.uid == request.resource.data.senderId &&
           !chatHasModeration() &&  // NUEVO: Bloquear si hay moderación activa
           (!request.resource.data.keys().hasAny(['text']) ||
            request.resource.data.text == null ||
            request.resource.data.text.size() <= 5000)) ||
          isCallMessage()
        );

        // Función auxiliar para verificar si solo se están actualizando campos de metadata (reacciones, estado, etc.)
        // NOTA: Permite campos timestamp dinámicos (deliveredAt_*, readAt_*) además de los campos estáticos
        // 🔒 SEGURIDAD: Limitaciones en reactions para prevenir abuso
        function isUpdatingOnlyMetadata() {
          let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

          // Campos críticos que NO deben cambiar
          let criticalFields = ['text', 'senderId', 'timestamp', 'imageUrl', 'videoUrl', 'audioUrl', 'type'];

          // Verificar si algún campo crítico está siendo modificado
          let criticalFieldsModified = changedKeys.hasAny(criticalFields);

          // Campos de metadata permitidos (estáticos)
          let allowedMetadataFields = ['reactions', 'status', 'readBy', 'deliveredTo', 'isRead'];

          // Verificar si TODOS los cambios son de metadata permitida o campos dinámicos (readAt_*, deliveredAt_*)
          let allChangesAreMetadata = changedKeys.hasOnly(allowedMetadataFields);

          // 🔒 SEGURIDAD: Si se modifican reactions, validar que no sea abuso
          // NOTA: No podemos validar estructura interna del map en Firestore rules
          // La validación completa se hace en código Flutter
          // Aquí solo limitamos el tamaño total de reactions keys
          let reactionsValid = !changedKeys.hasAny(['reactions']) ||
                               request.resource.data.get('reactions', {}).keys().size() <= 20;

          // Permitir si:
          // 1. NO se modifican campos críticos Y
          // 2. (Solo se modifican campos de metadata conocidos O hay algún campo de metadata en los cambios) Y
          // 3. Reactions es válido (si se modifica)
          return changedKeys.size() > 0 &&
                 !criticalFieldsModified &&
                 (allChangesAreMetadata || changedKeys.hasAny(allowedMetadataFields)) &&
                 reactionsValid;
        }

        // Permitir actualizar SI:
        // 1. Eres el sender Y solo editas tu mensaje (text, edited, editedAt) Y NO hay moderación activa, O
        // 2. Eres participante Y solo actualizas estado/reacciones (reactions, status, readBy, deliveredTo)
        // 🔒 SEGURIDAD: Bloquear edición de texto cuando hay moderación para evitar bypass
        // (enviar mensaje inocente, esperar aprobación, luego editarlo a ofensivo)
        allow update: if request.auth != null && (
          (request.auth.uid == resource.data.senderId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']) &&
           !chatHasModeration()) ||
          (isParticipant() && isUpdatingOnlyMetadata())
        );

        // Permitir eliminar si eres el sender
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.senderId;

        // Favorites - Favoritos de mensajes
        match /favorites/{userId} {
          // Permitir leer solo tu propio favorito
          allow read: if request.auth != null && request.auth.uid == userId;

          // Permitir crear/eliminar solo tu propio favorito
          allow create, delete: if request.auth != null && request.auth.uid == userId;

          // No permitir actualizar (solo crear/eliminar)
          allow update: if false;
        }
      }

      // Reactions - Reacciones a mensajes (subcollection separada)
      match /reactions/{reactionId} {
        // Función para verificar si es participante del chat
        function isParticipantForReactions() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          return request.auth.uid in chatDoc.data.participants;
        }

        // Permitir leer reacciones si eres participante
        allow read: if request.auth != null && isParticipantForReactions();

        // Permitir crear reacciones si:
        // 1. Eres participante del chat, Y
        // 2. El userId en la reacción es tu uid
        allow create: if request.auth != null &&
          isParticipantForReactions() &&
          request.resource.data.userId == request.auth.uid;

        // Permitir actualizar solo TUS propias reacciones
        allow update: if request.auth != null &&
          isParticipantForReactions() &&
          resource.data.userId == request.auth.uid;

        // Permitir eliminar solo TUS propias reacciones
        allow delete: if request.auth != null &&
          isParticipantForReactions() &&
          resource.data.userId == request.auth.uid;
      }

      // Typing indicators
      match /typing/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

        // Reported messages - Mensajes reportados por los usuarios como ofensivos
      match /reported_messages/{messageId} {
        // Permitir leer reportes si eres participante del chat
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Permitir crear reporte si eres participante del chat
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.auth.uid == request.resource.data.reportedBy;

        // Permitir eliminar si eres quien reportó (para desbloquear)
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.reportedBy;
      }
    }

    // Messages (colección global)
    // 🔒 SEGURIDAD: Esta colección global NO debe usarse directamente
    // Todos los mensajes van en subcollections: chats/{chatId}/messages o groups/{groupId}/messages
    // Bloquear completamente para prevenir bypass de validación de participantes
    match /messages/{messageId} {
      allow read: if false;  // Solo usar subcollections
      allow write: if false; // Solo usar subcollections
    }

    // Contactos
    match /contacts/{contactId} {
      // 🔒 FUNCIÓN: Verificar si el usuario es parentViewer de este contacto
      function isParentViewer() {
        return request.auth.uid in resource.data.get('parentViewers', []);
      }

      // 🔒 SEGURIDAD: Solo puedes leer contactos donde:
      // 1. TÚ estés en el array 'users', O
      // 2. Estés en el array 'parentViewers'
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isParentViewer()
      );

      // 🔒 SEGURIDAD CRÍTICA: Solo Cloud Functions pueden crear contactos
      // Esto previene bypass de validación de roles y aprobaciones
      allow create: if false;

      // 🔒 FUNCIÓN: Verificar que el padre solo actualiza campos permitidos
      function isUpdatingOnlyChildApproval() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Permite cambios en 'approvals', 'status', y campos de revocación
        return changedKeys.hasOnly(['approvals', 'status', 'revokedAt', 'revokedBy', 'revokedReason']);
      }

      // 🔒 FUNCIÓN: Verificar que el padre está aprobando/rechazando para un hijo válido
      function isValidApprovalUpdate() {
        // El padre debe estar en parentViewers
        let isParent = request.auth.uid in resource.data.get('parentViewers', []);

        // Solo verificar que el usuario es padre - permitir agregar/modificar approvals
        // ya que los contactos antiguos pueden tener approvals vacío
        return isParent;
      }

      // 🔒 FUNCIÓN: Campos no críticos que usuarios pueden modificar
      function isUpdatingNonCriticalFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Solo alias, nickname, isFavorite, metadata, storyNotifications
        return changedKeys.hasOnly(['alias', 'nickname', 'isFavorite', 'metadata', 'storyNotifications']);
      }

      // 🔒 FUNCIÓN: Verificar que solo se actualiza moderationSettings
      // La validación de permisos (parent vs child) se hace en el servicio
      function isUpdatingOnlyModerationSettings() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(['moderationSettings']);
      }

      // 🔒 FUNCIÓN: Verificar solicitud de aprobación válida (potential → pending/approved)
      function isValidApprovalRequest() {
        // Solo desde status 'potential'
        let fromPotential = resource.data.status == 'potential';
        // Solo hacia 'pending' o 'approved'
        let toValidStatus = request.resource.data.status == 'pending' ||
                           request.resource.data.status == 'approved';
        // El initiatorId debe ser el usuario actual
        let isInitiator = request.resource.data.initiatorId == request.auth.uid;
        // Campos permitidos para esta transición
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedKeys = ['status', 'initiatorId', 'requestedAt', 'approvals', 'completedApprovals', 'approvedAt'];
        let onlyAllowedKeys = changedKeys.hasOnly(allowedKeys);

        return fromPotential && toValidStatus && isInitiator && onlyAllowedKeys;
      }

      // 🔒 FUNCIÓN: Verificar cancelación válida (pending → rejected en approvals)
      function isValidCancelRequest() {
        // Solo si el contacto está en status 'pending'
        let isPending = resource.data.status == 'pending';
        // Solo modificar el approval del usuario actual
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let onlyApprovalsChanged = changedKeys.hasOnly(['approvals']);
        // Verificar que approvals existe y tiene entrada para el usuario
        let hasApprovals = 'approvals' in resource.data && resource.data.approvals != null;
        let hasMyApproval = hasApprovals && request.auth.uid in resource.data.approvals;
        // El usuario tiene un approval pendiente
        let hasMyPendingApproval = hasMyApproval && resource.data.approvals[request.auth.uid].status == 'pending';

        return isPending && onlyApprovalsChanged && hasMyPendingApproval;
      }

      // 🔒 FUNCIÓN: Verificar reenvío válido (cancelled/rejected → potential)
      function isValidResendRequest() {
        // Verificar que approvals existe y tiene entrada para el usuario
        let hasApprovals = 'approvals' in resource.data && resource.data.approvals != null;
        let hasMyApproval = hasApprovals && request.auth.uid in resource.data.approvals;
        // Solo desde status 'cancelled' o cuando el approval del usuario está en 'rejected'
        let myApprovalRejected = hasMyApproval && resource.data.approvals[request.auth.uid].status == 'rejected';
        // Solo hacia 'potential'
        let toPotential = request.resource.data.status == 'potential';
        // Campos permitidos
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedKeys = ['status', 'approvals'];
        let onlyAllowedKeys = changedKeys.hasOnly(allowedKeys);

        return myApprovalRejected && toPotential && onlyAllowedKeys;
      }

      // Permitir actualizar si:
      // 1. Eres usuario del contacto Y solo tocas campos no críticos, O
      // 2. Eres parentViewer Y solo actualizas approvals/status de forma válida, O
      // 3. Eres usuario del contacto Y es una solicitud de aprobación válida (potential → pending/approved), O
      // 4. Eres usuario del contacto Y es una cancelación válida (pending, tu approval → rejected), O
      // 5. Eres usuario del contacto Y es un reenvío válido (tu approval rejected → status potential), O
      // 6. Eres parentViewer Y solo actualizas moderationSettings (para activar moderación en hijos)
      // 🔒 NOTA: Solo padres pueden modificar moderationSettings - previene bypass de moderación
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.users && isUpdatingNonCriticalFields()) ||
        (isParentViewer() && isUpdatingOnlyChildApproval() && isValidApprovalUpdate()) ||
        (request.auth.uid in resource.data.users && isValidApprovalRequest()) ||
        (request.auth.uid in resource.data.users && isValidCancelRequest()) ||
        (request.auth.uid in resource.data.users && isValidResendRequest()) ||
        // 🔒 SEGURIDAD: Solo padres (parentViewer) pueden modificar moderationSettings
        // ELIMINADA la opción para usuarios normales - previene que un niño desactive su propia moderación
        (isParentViewer() && isUpdatingOnlyModerationSettings())
      );

      // 🔒 FUNCIÓN: Verificar eliminación válida de contacto rechazado
      function canDeleteRejectedContact() {
        // El usuario es parte del contacto
        let isParticipant = request.auth.uid in resource.data.users;
        // Verificar que approvals existe y tiene entrada para el usuario
        let hasApprovals = 'approvals' in resource.data && resource.data.approvals != null;
        let hasMyApproval = hasApprovals && request.auth.uid in resource.data.approvals;
        // Su approval está en 'rejected'
        let myApprovalRejected = hasMyApproval && resource.data.approvals[request.auth.uid].status == 'rejected';

        return isParticipant && myApprovalRejected;
      }

      // Permitir delete solo si el contacto está rechazado para el usuario
      allow delete: if request.auth != null && canDeleteRejectedContact();
    }

    // Notificaciones
    match /notifications/{notificationId} {
      allow get: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // 🔒 SEGURIDAD: Solo puedes listar TUS PROPIAS notificaciones
      // Cada documento se evalúa individualmente para verificar que userId == auth.uid
      allow list: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // ⚠️ Solo Cloud Functions pueden crear notificaciones (con permisos admin)
      // El cliente NO debe crear notificaciones directamente por seguridad
      allow create: if false;

      // Solo puedes actualizar tus propias notificaciones (ej: marcar como leído)
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Preferencias de notificaciones
    match /notification_preferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Excepciones de Do Not Disturb
    match /dnd_exceptions/{exceptionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Solicitudes de exportación de datos
    match /data_export_requests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false; // Solo Cloud Functions actualizan
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Logs de seguridad (solo lectura para el usuario, escritura para el servicio)
    match /security_logs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Analytics de notificaciones (opcional)
    match /notification_analytics/{analyticsId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Rate limits (solo Cloud Functions pueden escribir)
    match /rate_limits/{limitId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Solo Cloud Functions
    }

    // Configuraciones de padres
    match /parent_settings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Configuraciones de hijos
    match /child_settings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Actividades
    match /activities/{activityId} {
      allow read: if request.auth != null &&
        resource.data.parentId == request.auth.uid;

      // ⚠️ CORREGIDO: Solo puedes crear actividades donde TÚ eres el parentId
      allow create: if request.auth != null &&
        request.resource.data.parentId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.parentId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.parentId == request.auth.uid;
    }

    // Alertas
    match /alerts/{alertId} {
      allow read: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo puedes crear alertas donde TÚ eres participante
      allow create: if request.auth != null && (
        request.resource.data.childId == request.auth.uid ||
        request.resource.data.parentId == request.auth.uid
      );

      allow update: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      allow delete: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);
    }

    // Story approval requests
    match /story_approval_requests/{requestId} {
      // Permitir leer documento individual si eres parent o child
      allow get: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // 🔒 SEGURIDAD: Solo puedes listar solicitudes donde eres parent o child
      allow list: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo el child puede crear solicitudes de aprobación
      allow create: if request.auth != null &&
        request.resource.data.childId == request.auth.uid;

      // Solo el parent o child pueden actualizar (aprobar/rechazar)
      allow update: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      allow delete: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);
    }

    // Stories
    match /stories/{storyId} {
      // 🔒 FUNCIÓN DE SEGURIDAD: Verificar si el viewer es contacto aprobado del story owner
      function isApprovedContactForStory(storyUserId, viewerId) {
        // Si eres el owner, siempre puedes ver
        return storyUserId == viewerId ||
               // Verificar que no esté bloqueado
               (!exists(/databases/$(database)/documents/blocked_contacts/$(storyUserId + '_' + viewerId)) &&
                !exists(/databases/$(database)/documents/blocked_contacts/$(viewerId + '_' + storyUserId)));
      }

      // 🔒 FUNCIÓN DE SEGURIDAD: Verificar relación padre-hijo
      function isParentChildRelationForStory(storyUserId, viewerId) {
        // Buscar en la colección users si hay relación padre-hijo
        return get(/databases/$(database)/documents/users/$(storyUserId)).data.linkedChildrenIds != null &&
               viewerId in get(/databases/$(database)/documents/users/$(storyUserId)).data.linkedChildrenIds ||
               get(/databases/$(database)/documents/users/$(viewerId)).data.linkedChildrenIds != null &&
               storyUserId in get(/databases/$(database)/documents/users/$(viewerId)).data.linkedChildrenIds;
      }

      // 🔒 FUNCIÓN DE SEGURIDAD: Verificar si puede acceder via story_approval_requests
      function hasStoryApprovalAccess(storyUserId, viewerId) {
        // Simplificado: verificar si el viewer es padre del story owner
        return get(/databases/$(database)/documents/users/$(viewerId)).data.linkedChildrenIds != null &&
               storyUserId in get(/databases/$(database)/documents/users/$(viewerId)).data.linkedChildrenIds;
      }

      // 🔒 FUNCIÓN: Verificar si el usuario puede ver esta historia específica
      // ✅ OPTIMIZADO: Usa availableFor y parentViewers para queries eficientes
      function canViewThisStory() {
        return request.auth.uid == resource.data.userId ||
               // ✅ Check optimizado usando availableFor (historias aprobadas para contactos)
               (resource.data.status == 'approved' &&
                resource.data.availableFor != null &&
                request.auth.uid in resource.data.availableFor) ||
               // ✅ NUEVO: Check usando parentViewers (historias de hijos para padres)
               (resource.data.parentViewers != null &&
                request.auth.uid in resource.data.parentViewers) ||
               // FALLBACK: Lógica antigua para historias sin availableFor o pending/rejected
               (resource.data.status == 'approved' && isApprovedContactForStory(resource.data.userId, request.auth.uid)) ||
               isParentChildRelationForStory(resource.data.userId, request.auth.uid) ||
               hasStoryApprovalAccess(resource.data.userId, request.auth.uid);
      }

      // Función auxiliar para verificar si solo se está actualizando viewedBy
      // 🔒 SEGURIDAD: Validar que solo agregues TU PROPIO uid a viewedBy
      function isOnlyUpdatingViewedBy() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let oldViewedBy = resource.data.get('viewedBy', []);
        let newViewedBy = request.resource.data.get('viewedBy', []);
        // Solo puede agregar, no remover
        // Solo puede agregar SU uid
        return changedKeys.hasOnly(['viewedBy']) &&
               newViewedBy.hasAll(oldViewedBy) &&
               newViewedBy.size() <= oldViewedBy.size() + 1 &&
               (newViewedBy.size() == oldViewedBy.size() || newViewedBy.hasAny([request.auth.uid]));
      }

      // 🔒 SEGURIDAD CRÍTICA: Replies BLOQUEADOS desde cliente
      // Los replies DEBEN crearse via Cloud Function replyToStory que:
      // 1. Valida userId == auth.uid (previene spoofing)
      // 2. Valida permisos de contacto
      // 3. Aplica rate limiting
      // 4. Pasa por moderación automática
      function isOnlyUpdatingReplies() {
        // SIEMPRE retorna false - replies solo via Cloud Function
        return false;
      }

      // 🔒 SEGURIDAD: Validar que solo agregues TU PROPIO uid a likedBy
      function isOnlyUpdatingLikedBy() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let oldLikedBy = resource.data.get('likedBy', []);
        let newLikedBy = request.resource.data.get('likedBy', []);
        // Puede agregar O remover solo SU uid (like/unlike)
        let sizeDiff = newLikedBy.size() - oldLikedBy.size();
        return changedKeys.hasOnly(['likedBy']) &&
               (sizeDiff == 1 || sizeDiff == -1) &&
               (newLikedBy.hasAny([request.auth.uid]) || oldLikedBy.hasAny([request.auth.uid]));
      }

      // 🔒 SEGURIDAD CRÍTICA: Campos de aprobación BLOQUEADOS para clientes
      // Solo Cloud Functions pueden modificar status, approvedBy, approvedAt, rejectionReason
      function isOnlyUpdatingApprovalFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // BLOQUEAR completamente cambios de status desde cliente
        // Solo permitir updatedAt (timestamp automático)
        return changedKeys.size() > 0 &&
               changedKeys.hasOnly(['updatedAt']) &&
               !changedKeys.hasAny(['status', 'approvedBy', 'approvedAt', 'rejectionReason']);
      }

      // Función auxiliar para verificar si solo se están actualizando campos de visibilidad/archivado
      function isOnlyUpdatingVisibilityFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Permitir actualizar visibility y savedToPermanentAt (para guardar/archivar historias)
        // 🔒 IMPORTANTE: NO permitir cambiar status o availableFor desde cliente
        return changedKeys.size() > 0 &&
               changedKeys.hasOnly(['visibility', 'savedToPermanentAt']) &&
               !changedKeys.hasAny(['status', 'availableFor']);
      }

      // 🔒 SEGURIDAD: Verificar que no se modifique availableFor desde cliente
      function isNotModifyingAvailableFor() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return !changedKeys.hasAny(['availableFor']);
      }

      // 🔒 SEGURIDAD CRÍTICA: Reglas extremadamente restrictivas para historias
      // Permitir leer historia individual SOLO si:
      // 1. Eres el creador (owner), O
      // 2. Eres contacto aprobado del creador Y la historia está aprobada, O
      // 3. Eres padre/hijo del creador (relación verificada), O
      // 4. Tienes acceso via story_approval_requests como padre
      allow get: if request.auth != null && canViewThisStory();

      // 🔒 SEGURIDAD: Para queries (list), permitir si:
      // 1. El usuario consulta sus PROPIAS historias (userId == auth.uid), O
      // 2. Puede ver la historia según canViewThisStory()
      // ✅ FIX: Permitir explícitamente queries por userId propio
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        canViewThisStory()
      );

      // Solo el creador puede crear su propia historia
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;

      // 🔒 ACTUALIZACIÓN SEGURA: Permitir actualizar SOLO si:
      // 1. Eres el creador de la historia Y NO modificas availableFor, O
      // 2. Puedes ver la historia Y solo agregando a viewedBy/replies/likes (permite interacciones), O
      // 3. Tienes acceso de aprobación Y solo actualizas campos de aprobación, O
      // 4. Eres el creador Y solo actualizas campos de visibilidad
      // 🔒 NOTA: availableFor solo puede ser modificado por Cloud Functions
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId && isNotModifyingAvailableFor()) ||
        (canViewThisStory() && (isOnlyUpdatingViewedBy() || isOnlyUpdatingReplies() || isOnlyUpdatingLikedBy())) ||
        (hasStoryApprovalAccess(resource.data.userId, request.auth.uid) && isOnlyUpdatingApprovalFields()) ||
        (request.auth.uid == resource.data.userId && isOnlyUpdatingVisibilityFields())
      );

      // Solo el creador puede eliminar su historia
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // Grupos
    match /groups/{groupId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // 🔒 SEGURIDAD CRÍTICA: Solo Cloud Functions pueden crear grupos
      // Los clientes DEBEN usar la Cloud Function correspondiente que valida permisos
      allow create: if false;

      // 🔒 FUNCIÓN DE SEGURIDAD: Verificar si se están actualizando campos críticos que solo Cloud Functions pueden modificar
      function isUpdatingCriticalGroupFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // CAMPOS CRÍTICOS que solo Cloud Functions pueden actualizar para prevenir bypass de filtros
        let criticalFields = ['lastMessage', 'lastMessageTime', 'lastMessageSender'];
        return changedKeys.hasAny(criticalFields);
      }

      // Permitir actualizar si:
      // 1. NO está tocando campos críticos Y (eres miembro actual O eras miembro antes)
      // 🔒 NUEVO: Prohibir actualización de lastMessage, lastMessageTime, lastMessageSender desde frontend
      allow update: if request.auth != null && !isUpdatingCriticalGroupFields() && (
        request.auth.uid in request.resource.data.members ||
        request.auth.uid in resource.data.members
      );

      // Permitir eliminar si eres el creador
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        // Función auxiliar para verificar si eres miembro del grupo
        function isGroupMember() {
          let groupDoc = get(/databases/$(database)/documents/groups/$(groupId));
          return request.auth.uid in groupDoc.data.members;
        }

        // Solo miembros del grupo pueden leer mensajes
        allow read: if request.auth != null && isGroupMember();

        // 🔒 SEGURIDAD CRÍTICA: Permitir crear mensaje SOLO si:
        // 1. Eres el sender (senderId == auth.uid), Y
        // 2. Eres MIEMBRO del grupo (validado en Firestore)
        allow create: if request.auth != null &&
          isGroupMember() &&
          request.auth.uid == request.resource.data.senderId;

        // Permitir actualizar si:
        // 1. Eres el sender (para editar/eliminar), O
        // 2. Eres miembro del grupo (para marcar como leído, delivered, etc.)
        allow update: if request.auth != null && isGroupMember();

        // Permitir eliminar si eres el sender
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.senderId;

        // Favorites - Favoritos de mensajes de grupo
        match /favorites/{userId} {
          // Permitir leer solo tu propio favorito
          allow read: if request.auth != null && request.auth.uid == userId;

          // Permitir crear/eliminar solo tu propio favorito
          allow create, delete: if request.auth != null && request.auth.uid == userId;

          // No permitir actualizar (solo crear/eliminar)
          allow update: if false;
        }
      }

      // Typing indicators
      match /typing/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }

    // Parent approval requests
    match /parent_approval_requests/{requestId} {
      // Permitir leer documentos individuales si el usuario está involucrado
      allow get: if request.auth != null &&
        (resource.data.existingParentId == request.auth.uid ||
         resource.data.newParentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // 🔒 SEGURIDAD: Solo puedes listar solicitudes donde estés involucrado
      allow list: if request.auth != null &&
        (resource.data.existingParentId == request.auth.uid ||
         resource.data.newParentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo puedes crear solicitud si TÚ eres el newParentId
      allow create: if request.auth != null &&
        request.resource.data.newParentId == request.auth.uid;

      // Solo el existingParent o child pueden actualizar (aprobar/rechazar)
      allow update: if request.auth != null &&
        (resource.data.existingParentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // El newParent o existingParent pueden eliminar la solicitud
      // (útil cuando se desvincula un hijo y se necesita limpiar solicitudes pendientes)
      allow delete: if request.auth != null &&
        (resource.data.newParentId == request.auth.uid ||
         resource.data.existingParentId == request.auth.uid);
    }

    // Link codes
    // 🔒 SEGURIDAD: Solo el creador puede leer sus códigos
    // La búsqueda por código se hace via Cloud Function validateLinkCode
    // Esto previene enumeración de códigos de otros usuarios
    match /link_codes/{codeId} {
      // 🔒 SEGURIDAD: Solo el creador puede leer documentos individuales
      // El hijo usa Cloud Function validateLinkCode para buscar códigos
      allow get: if request.auth != null &&
        request.auth.uid == resource.data.createdBy;

      // 🔒 SEGURIDAD: Solo el creador puede listar sus propios códigos
      // Previene enumeración de códigos activos de otros usuarios
      allow list: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;

      // Permitir crear código si el usuario es el createdBy
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.createdBy;

      // Permitir actualizar si:
      // 1. Eres el creador (padre), O
      // 2. Estás marcando el código como usado (hijo vinculándose)
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt', 'isActive']) &&
         request.resource.data.used == true &&
         request.resource.data.usedBy == request.auth.uid)
      );

      // Permitir eliminar solo si es el creador
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.createdBy;
    }

    // User codes (códigos de usuario para agregar contactos)
    // 🔒 SEGURIDAD: Solo puedes leer TU PROPIO código
    // La búsqueda de códigos de otros usuarios se hace via Cloud Function findUserByCode
    match /user_codes/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Locations
    match /locations/{locationId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // ⚠️ CORREGIDO: Solo puedes escribir TU PROPIA ubicación
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // ============================================================================
    // CALLS V2 (Agora Video Calls)
    // ============================================================================
    match /calls_v2/{callId} {
      // Función auxiliar para verificar si el usuario es participante
      function isParticipant() {
        return resource.data.participants != null &&
               resource.data.participants[request.auth.uid] != null;
      }

      // 🔒 SEGURIDAD: Validar que solo se actualicen campos permitidos para participantes
      // Campos permitidos:
      // - participants.{uid}.status (cambiar estado del participante)
      // - participants.{uid}.joinedAt (cuando se une)
      // - participants.{uid}.leftAt (cuando se va)
      // - endedAt (terminar la llamada)
      // - endedBy (quién terminó)
      // - endReason (razón del fin)
      function isValidCallUpdate() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedTopLevel = ['endedAt', 'endedBy', 'endReason', 'participants'];

        // Verificar que solo se cambian campos permitidos de nivel superior
        return changedKeys.hasOnly(allowedTopLevel);
      }

      // 🔒 SEGURIDAD: Verificar que no se agregan ni eliminan participantes
      // Los participantes solo pueden ser agregados por Cloud Functions
      function isNotChangingParticipantKeys() {
        let oldParticipants = resource.data.participants;
        let newParticipants = request.resource.data.participants;

        // Si no hay cambios en participants, está bien
        // O verificar que las keys de participantes son las mismas
        // (no se pueden agregar ni eliminar participantes, solo modificar status)
        return oldParticipants == newParticipants ||
               (newParticipants.keys().hasAll(oldParticipants.keys()) &&
                oldParticipants.keys().hasAll(newParticipants.keys()));
      }

      // Permitir leer si eres participante
      allow read: if request.auth != null && (
        resource == null ||
        isParticipant()
      );

      // Solo Cloud Functions pueden crear llamadas
      allow create: if false;

      // 🔒 SEGURIDAD: Permitir actualizar solo campos específicos si eres participante
      // Nota: Los participantes pueden actualizar el status de otros (ej: marcar como 'missed')
      // pero NO pueden agregar ni eliminar participantes de la llamada
      allow update: if request.auth != null &&
        resource != null &&
        isParticipant() &&
        isValidCallUpdate() &&
        isNotChangingParticipantKeys();

      // Permitir eliminar si eres el creador
      allow delete: if request.auth != null &&
        resource != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // User calls - Para notificaciones de llamadas entrantes sin índices
    match /user_calls/{userId} {
      // Permitir leer solo tus propios user_calls
      allow read: if request.auth != null && request.auth.uid == userId;

      // Solo Cloud Functions pueden escribir
      // Nota: Cloud Functions usando Admin SDK bypasean estas reglas completamente,
      // así que 'allow write: if false' solo afecta a clientes, no a Cloud Functions
      allow write: if false;

      // Incoming calls subcollection
      match /incoming/{callId} {
        // Permitir leer solo tus propias llamadas entrantes
        allow read: if request.auth != null && request.auth.uid == userId;

        // Solo Cloud Functions pueden escribir
        // Nota: Admin SDK bypasea esta regla - Cloud Functions pueden escribir sin restricción
        allow write: if false;
      }
    }

    // ============================================================================
    // ❌ LEGACY: video_calls - BLOQUEADO
    // ============================================================================
    // Esta colección ya NO se usa. El sistema de llamadas usa 'calls_v2'.
    // Solo Cloud Functions (con Admin SDK) pueden acceder para migración/cleanup.
    // Los clientes NO deben tener acceso.
    match /video_calls/{callId} {
      allow read: if false;
      allow write: if false;
    }

    // Chat permissions
    match /chat_permissions/{permissionId} {
      allow read: if request.auth != null &&
        (resource.data.childId == request.auth.uid ||
         resource.data.parentId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo el parent puede crear/modificar permisos
      allow create: if request.auth != null &&
        request.resource.data.parentId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.parentId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.parentId == request.auth.uid;
    }

    // User locations
    match /user_locations/{userId} {
      // Permitir lectura si es el usuario mismo
      // O si el usuario autenticado está en la lista de padres aprobados
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.approvedParents != null && request.auth.uid in resource.data.approvedParents)
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Location history
    match /location_history/{locationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // ⚠️ CORREGIDO: Solo puedes escribir TU PROPIO historial
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Whitelist
    match /whitelist/{whitelistId} {
      allow read: if request.auth != null &&
        (resource.data.childId == request.auth.uid ||
         resource.data.parentId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo el parent puede crear/modificar whitelist
      allow create: if request.auth != null &&
        request.resource.data.parentId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.parentId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.parentId == request.auth.uid;
    }

    // Blocked chats
    match /blocked_chats/{blockedId} {
      // Función auxiliar: verificar si es padre del childId en el documento existente
      function isParentOfBlockedChatChild() {
        return resource != null &&
               resource.data != null &&
               resource.data.childId != null &&
               (exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + resource.data.childId)) ||
                exists(/databases/$(database)/documents/parent_children/$(resource.data.childId + '_' + request.auth.uid)));
      }

      // Función auxiliar: verificar si es padre del childId en los datos nuevos (para create)
      function isParentOfNewChildId() {
        return request.resource.data.childId != null &&
               (exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + request.resource.data.childId)) ||
                exists(/databases/$(database)/documents/parent_children/$(request.resource.data.childId + '_' + request.auth.uid)));
      }

      // Permitir leer si:
      // 1. Eres uno de los participantes (tu UID está en el documento ID), O
      // 2. El documento existe Y eres padre del childId
      allow read: if request.auth != null && (
        blockedId.matches('.*' + request.auth.uid + '.*') ||
        isParentOfBlockedChatChild()
      );

      // ✅ Permitir crear si:
      // 1. Eres el childId (el niño mismo), O
      // 2. Eres padre verificado del childId (via parent_children)
      allow create: if request.auth != null && (
        request.resource.data.childId == request.auth.uid ||
        isParentOfNewChildId()
      );

      // ✅ Permitir actualizar si:
      // 1. Eres el childId, O
      // 2. Eres padre verificado del childId
      allow update: if request.auth != null && (
        resource.data.childId == request.auth.uid ||
        isParentOfBlockedChatChild()
      );

      // ✅ Permitir eliminar si:
      // 1. Eres el childId, O
      // 2. Eres padre verificado del childId
      allow delete: if request.auth != null && (
        resource.data.childId == request.auth.uid ||
        isParentOfBlockedChatChild()
      );
    }

    // Blocked contacts
    match /blocked_contacts/{blockedId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.blockedUserId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo puedes bloquear si TÚ eres el userId
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Message analysis (AI analysis)
    match /message_analysis/{analysisId} {
      // CORREGIDO: Solo el usuario o sus padres pueden ver el análisis
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds));
      allow write: if false; // Solo Cloud Functions
    }

    // AI batch analysis
    match /ai_batch_analysis/{batchId} {
      // CORREGIDO: Solo el usuario o sus padres pueden ver el análisis
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds));
      allow write: if false; // Solo Cloud Functions
    }

    // Support reports
    // 🔒 SEGURIDAD: Validar campos requeridos y limitar tamaño para prevenir abuso
    match /support_reports/{reportId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Solo permitir create con validación de campos
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'category', 'title', 'description', 'status', 'createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 5 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 10 &&
        request.resource.data.description.size() <= 5000 &&
        request.resource.data.status == 'pending';

      // No permitir update desde cliente (solo admins via Cloud Functions)
      allow update: if false;

      // Solo permitir delete del propio reporte
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Connection tests
    match /connection_test/{testId} {
      // CORREGIDO: Solo el usuario puede ver sus tests de conexión
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow write: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // DEPRECATED: contact_requests - ya no se usa
    // Las aprobaciones ahora se almacenan en contacts.approvals
    // Los padres aprueban/rechazan directamente via WhitelistController + Security Rules en /contacts
    match /contact_requests/{requestId} {
      allow read, write: if false;
    }

    // Weekly reports
    match /weekly_reports/{reportId} {
      allow read: if request.auth != null &&
        (resource.data.childId == request.auth.uid ||
         resource.data.parentId == request.auth.uid);
      // Solo Cloud Functions pueden crear/actualizar
      allow create, update: if false;
      // El padre puede eliminar sus propios reportes
      allow delete: if request.auth != null &&
        resource.data.parentId == request.auth.uid;
    }

    // Pending reports - Reportes en proceso de generación
    match /pending_reports/{reportId} {
      // Solo el padre que solicitó el reporte puede leerlo
      allow read: if request.auth != null &&
        resource.data.parentId == request.auth.uid;

      // Solo Cloud Functions pueden escribir
      allow write: if false;
    }

    // Emergencies
    match /emergencies/{emergencyId} {
      // Función auxiliar para verificar si el usuario es padre del niño de la emergencia
      // Usa linkedChildrenIds del documento de usuario (más confiable que parent_children IDs)
      function isParentOfEmergencyChild() {
        let childId = resource.data.childId;
        let parentDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return parentDoc.data.linkedChildrenIds != null &&
               childId in parentDoc.data.linkedChildrenIds;
      }

      // Permitir leer documento individual si eres el niño O eres padre del niño
      allow get: if request.auth != null && (
        request.auth.uid == resource.data.childId ||
        isParentOfEmergencyChild()
      );

      // 🔒 SEGURIDAD: Solo puedes listar emergencias donde eres el niño o padre vinculado
      allow list: if request.auth != null && (
        request.auth.uid == resource.data.childId ||
        isParentOfEmergencyChild()
      );

      // Permitir crear/actualizar si eres el niño o un padre con status approved
      allow write: if request.auth != null && (
        request.auth.uid == request.resource.data.childId ||
        isParentOfEmergencyChild()
      );

      // Location tracking subcollection
      match /location_tracking/{trackingId} {
        // Heredar permisos del documento padre usando linkedChildrenIds
        function isAuthorizedForEmergencyTracking() {
          let emergencyDoc = get(/databases/$(database)/documents/emergencies/$(emergencyId));
          let childId = emergencyDoc.data.childId;
          // Si eres el niño, tienes acceso
          return request.auth.uid == childId;
        }

        function isParentAuthorizedForTracking() {
          let emergencyDoc = get(/databases/$(database)/documents/emergencies/$(emergencyId));
          let childId = emergencyDoc.data.childId;
          let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
          // Verificar que el usuario tenga linkedChildrenIds y que el childId esté en la lista
          return userDoc.data.keys().hasAny(['linkedChildrenIds']) &&
                 childId in userDoc.data.linkedChildrenIds;
        }

        // Permitir leer si estás autorizado (niño o padre)
        allow read: if request.auth != null &&
          (isAuthorizedForEmergencyTracking() || isParentAuthorizedForTracking());

        // Permitir escribir si estás autorizado (niño o padre)
        // El niño puede agregar puntos de ubicación a su propia emergencia
        allow write: if request.auth != null &&
          (isAuthorizedForEmergencyTracking() || isParentAuthorizedForTracking());
      }
    }

    // Permission requests (para invitaciones a grupos, etc)
    match /permission_requests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      // ⚠️ CORREGIDO: Solo puedes crear solicitudes donde TÚ eres participante
      allow create: if request.auth != null && (
        request.resource.data.childId == request.auth.uid ||
        request.resource.data.parentId == request.auth.uid
      );

      allow update: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);

      allow delete: if request.auth != null &&
        (resource.data.parentId == request.auth.uid ||
         resource.data.childId == request.auth.uid);
    }

    // Group requests (solicitudes para unirse a grupos)
    match /group_requests/{requestId} {
      // Función auxiliar para verificar si eres miembro del grupo
      function isGroupMember() {
        let groupDoc = get(/databases/$(database)/documents/groups/$(resource.data.groupId));
        return request.auth.uid in groupDoc.data.members;
      }

      // Función auxiliar para verificar si eres admin del grupo
      function isGroupAdmin() {
        let groupDoc = get(/databases/$(database)/documents/groups/$(resource.data.groupId));
        return groupDoc.data.admins != null &&
               request.auth.uid in groupDoc.data.admins;
      }

      // Permitir leer si eres miembro del grupo o eres quien hizo la solicitud
      allow read: if request.auth != null && (
        isGroupMember() ||
        resource.data.userId == request.auth.uid
      );

      // Solo Cloud Functions pueden crear solicitudes
      allow create: if false;

      // Solo admins del grupo pueden actualizar (aprobar/rechazar)
      allow update: if request.auth != null && isGroupAdmin();

      // Solo el usuario que hizo la solicitud puede eliminarla (cancelar)
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Group invitations (con aprobación en cascada) - LEGACY
    // TODO: Migrar a Groups V2 y eliminar esta colección
    match /groupInvitations/{invitationId} {
      // 🔒 SEGURIDAD: Solo puedes leer invitaciones donde estés involucrado
      // o eres padre de algún miembro (para badges de notificación)
      function isParentOfInvitedChild() {
        let parentDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return parentDoc.data.linkedChildrenIds != null &&
               resource.data.invitedChildId != null &&
               resource.data.invitedChildId in parentDoc.data.linkedChildrenIds;
      }

      function isInvolvedInInvitation() {
        return resource.data.invitedUserId == request.auth.uid ||
               resource.data.invitedBy == request.auth.uid ||
               resource.data.parentId == request.auth.uid ||
               (resource.data.invitedParentApproval != null &&
                resource.data.invitedParentApproval.parentId == request.auth.uid) ||
               isParentOfInvitedChild();
      }

      allow get: if request.auth != null && isInvolvedInInvitation();

      // 🔒 SEGURIDAD: Solo puedes listar invitaciones donde estés involucrado
      allow list: if request.auth != null && isInvolvedInInvitation();

      // Permitir crear invitaciones (usando invitedBy en lugar de inviterId)
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.invitedBy;

      // ⚠️ CORREGIDO: Solo puedes actualizar si eres el invitado, invitador, o padre
      allow update: if request.auth != null && (
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedBy == request.auth.uid ||
        resource.data.parentId == request.auth.uid
      );

      // Solo Cloud Functions pueden eliminar
      allow delete: if false;
    }

    // Stickers - Colección pública de stickers para stories
    match /stickers/{stickerId} {
      // Permitir lectura a todos los usuarios autenticados
      allow read: if request.auth != null;

      // ⚠️ CORREGIDO: Solo admins pueden crear/modificar stickers
      allow write: if isAdmin();
    }

    // User limits - Límites de uso de funcionalidades premium
    match /user_limits/{userId} {
      // Solo el usuario puede leer sus propios límites
      allow read: if request.auth != null && request.auth.uid == userId;

      // Solo el usuario puede actualizar/crear sus propios límites
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // App config - Configuración global de la aplicación (feature flags)
    match /app_config/{configId} {
      // Todos los usuarios autenticados pueden leer la configuración
      allow read: if request.auth != null;

      // Solo admins pueden escribir configuración
      allow write: if isAdmin();
    }

    // Characters - Personajes para transformación con IA
    match /characters/{characterId} {
      // Permitir lectura a todos los usuarios autenticados
      allow read: if request.auth != null;

      // Permitir escritura solo a admins
      // Los admins tienen el campo isAdmin: true en users collection
      allow write: if isAdmin();
    }

    // Character transformations - Analytics de transformaciones
    // ✅ RENAMED: characterTransformations → character_transformations (snake_case)
    match /character_transformations/{transformId} {
      // Solo lectura para el usuario que hizo la transformación o admins
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Solo Cloud Functions pueden crear transformaciones
      allow create: if false;

      // No permitir modificar o eliminar transformaciones
      allow update, delete: if false;
    }

    // Estado de transformaciones en tiempo real
    // ✅ RENAMED: transformationStatus → transformation_status (snake_case)
    match /transformation_status/{statusId} {
      // Solo lectura para el usuario que hizo la transformación
      // Permite snapshots() en tiempo real
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Solo Cloud Functions pueden crear/actualizar estado
      allow create, update: if false;

      // No permitir eliminar
      allow delete: if false;
    }

    // ============================================================================
    // SUBSCRIPTIONS & PREMIUM (Sistema de suscripciones premium)
    // ============================================================================

    // Subscriptions - Registro de suscripciones activas/canceladas
    match /subscriptions/{subscriptionId} {
      // Función auxiliar para verificar si el usuario es padre del userId de la suscripción
      function isParentOfSubscriptionUser() {
        let userId = resource.data.userId;
        return exists(/databases/$(database)/documents/parent_children/$(request.auth.uid + '_' + userId)) ||
               exists(/databases/$(database)/documents/parent_children/$(userId + '_' + request.auth.uid));
      }

      // Permitir leer si:
      // 1. Eres el usuario de la suscripción, O
      // 2. Eres padre del usuario (para ver suscripciones de hijos), O
      // 3. Eres admin
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isParentOfSubscriptionUser() ||
        isAdmin()
      );

      // Solo Cloud Functions pueden crear/modificar suscripciones
      // Esto garantiza que los pagos sean verificados por el backend
      allow create, update, delete: if false;
    }

    // Checkout Sessions - Sesiones de pago web temporales (Stripe/MercadoPago)
    match /checkout_sessions/{sessionId} {
      // Solo puedes leer tus propias sesiones de checkout
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Solo Cloud Functions pueden crear/modificar sesiones
      allow create, update, delete: if false;
    }

    // Payment History - Historial de pagos (opcional para auditoría)
    match /payment_history/{paymentId} {
      // Solo puedes leer tu propio historial de pagos
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Solo Cloud Functions pueden crear pagos
      allow create, update, delete: if false;
    }

    // Promo Codes - Códigos promocionales para premium gratis/descuento
    match /promo_codes/{codeId} {
      // Todos pueden leer códigos promocionales (para validar al aplicar)
      allow read: if request.auth != null;

      // Solo admins pueden crear/modificar códigos
      allow write: if isAdmin();
    }

    // Promo Code Redemptions - Registro de canje de códigos promo
    match /promo_code_redemptions/{redemptionId} {
      // Solo puedes ver tus propios canjes
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Los usuarios pueden crear sus propios canjes
      // (la validación de duplicados se hace en Cloud Functions)
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Solo Cloud Functions pueden actualizar/eliminar
      allow update, delete: if false;
    }

    // ============================================================================
    // GROUPS V2 (New groups system with parent approval)
    // ============================================================================

    // Groups V2 - Nueva colección de grupos con aprobación parental
    match /groups_v2/{groupId} {
      // Miembros activos o pendientes pueden leer el grupo
      // Padres de miembros/pendientes también pueden leer (para whitelist)
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (resource.data.pendingMembers != null && request.auth.uid in resource.data.pendingMembers) ||
        isParentOfAnyMemberOrPending(resource.data)
      );

      // Función para verificar si es padre de algún miembro o pendiente
      // Usa linkedChildrenIds para verificar si alguno de sus hijos está en el grupo
      function isParentOfAnyMemberOrPending(groupData) {
        let parentDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let myChildren = parentDoc.data.linkedChildrenIds;

        // Si no tiene hijos vinculados, no es padre de nadie
        let hasChildren = myChildren != null;

        // Verificar si alguno de sus hijos está en members o pendingMembers
        let hasChildInMembers = hasChildren && groupData.members.hasAny(myChildren);
        let hasChildInPending = hasChildren &&
                                groupData.pendingMembers != null &&
                                groupData.pendingMembers.hasAny(myChildren);

        return hasChildInMembers || hasChildInPending;
      }

      // Solo Cloud Functions pueden crear grupos
      allow create: if false;

      // Función para verificar si solo se actualizan campos permitidos
      function isUpdatingOnlyAllowedGroupFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Campos que los miembros pueden actualizar
        return changedKeys.hasOnly(['lastActivity', 'lastMessage', 'lastMessageTime', 'lastMessageSender', 'lastMessageId', 'unreadCount_' + request.auth.uid]);
      }

      // Validar cambios en admins cuando alguien sale
      function isValidAdminsChangeOnLeave() {
        // Caso 1: Sin cambios en admins
        let noChange = request.resource.data.admins == resource.data.admins;

        // Caso 2: Usuario se remueve de admins (tamaño -1)
        let removingSelf = request.auth.uid in resource.data.admins &&
                           !(request.auth.uid in request.resource.data.admins) &&
                           request.resource.data.admins.size() == resource.data.admins.size() - 1;

        // Caso 3: Último admin sale y promueve a otro (tamaño igual, usuario cambia)
        // El usuario era el ÚNICO admin, se remueve, y hay exactamente 1 nuevo admin
        let lastAdminPromoting = resource.data.admins.size() == 1 &&
                                  request.auth.uid in resource.data.admins &&
                                  !(request.auth.uid in request.resource.data.admins) &&
                                  request.resource.data.admins.size() == 1;

        return noChange || removingSelf || lastAdminPromoting;
      }

      // Validar cambios en pendingMembers cuando alguien sale
      function isValidPendingChangeOnLeave() {
        // Sin cambios O el usuario se remueve a sí mismo
        let unchanged = request.resource.data.pendingMembers == resource.data.pendingMembers;
        let removing = resource.data.pendingMembers != null &&
                       request.auth.uid in resource.data.pendingMembers &&
                       !(request.auth.uid in request.resource.data.pendingMembers);
        return unchanged || removing;
      }

      // Validar isActive cuando alguien sale
      function isValidIsActiveChangeOnLeave() {
        // Sin cambios O false solo cuando members queda vacío
        return request.resource.data.isActive == resource.data.isActive ||
               (request.resource.data.isActive == false && request.resource.data.members.size() == 0);
      }

      // Función principal para verificar si el usuario está saliendo del grupo
      function isLeavingGroup() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedFields = ['members', 'admins', 'pendingMembers', 'isActive', 'updatedAt'];

        return changedKeys.hasOnly(allowedFields) &&
               request.auth.uid in resource.data.members &&
               !(request.auth.uid in request.resource.data.members) &&
               isValidAdminsChangeOnLeave() &&
               isValidPendingChangeOnLeave() &&
               isValidIsActiveChangeOnLeave();
      }

      // Función para verificar si es padre modificando membresía de su hijo
      // Verifica que: 1) Solo modifica campos permitidos, 2) Tiene hijos vinculados,
      // 3) Al menos uno de sus hijos está en pendingMembers o members del grupo
      function isParentModifyingChildMembership() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedParentFields = ['members', 'memberDetails', 'memberCount', 'pendingMembers', 'pendingMemberDetails', 'pendingCount', 'updatedAt'];

        // Obtener los hijos vinculados del padre
        let parentDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let myChildren = parentDoc.data.linkedChildrenIds;

        // Verificar que:
        // 1. Solo se modifican campos permitidos
        // 2. El caller tiene hijos vinculados
        // 3. Al menos uno de sus hijos está en pendingMembers (para aprobar) O en members (para revocar)
        let hasChildInPending = resource.data.pendingMembers != null &&
                                myChildren != null &&
                                resource.data.pendingMembers.hasAny(myChildren);
        let hasChildInMembers = resource.data.members != null &&
                                myChildren != null &&
                                resource.data.members.hasAny(myChildren);

        return changedKeys.hasOnly(allowedParentFields) &&
               myChildren != null &&
               (hasChildInPending || hasChildInMembers);
      }

      // Función para verificar si un admin está actualizando moderación
      function isAdminUpdatingModeration() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let moderationFields = ['moderationEnabled', 'moderationLevel', 'moderationUpdatedAt', 'moderationUpdatedBy'];

        // Verificar que el usuario es admin del grupo
        let isAdmin = resource.data.admins != null && request.auth.uid in resource.data.admins;

        // Solo se modifican campos de moderación
        return isAdmin && changedKeys.hasOnly(moderationFields);
      }

      // Miembros pueden actualizar campos de actividad y su propio unreadCount
      // O pueden salir del grupo (removerse a sí mismos del array members)
      // Padres pueden modificar membresía de sus hijos (approve/revoke)
      // Admins pueden actualizar configuración de moderación
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.members && isUpdatingOnlyAllowedGroupFields()) ||
        isLeavingGroup() ||
        isParentModifyingChildMembership() ||
        isAdminUpdatingModeration()
      );

      // Solo Cloud Functions pueden eliminar grupos
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Función para verificar si eres miembro del grupo
        function isGroupV2Member() {
          let groupDoc = get(/databases/$(database)/documents/groups_v2/$(groupId));
          return request.auth.uid in groupDoc.data.members;
        }

        // Función para verificar si el grupo tiene moderación activa
        function groupHasModeration() {
          let groupDoc = get(/databases/$(database)/documents/groups_v2/$(groupId));
          return groupDoc.data.moderationEnabled == true;
        }

        // Solo miembros pueden leer mensajes
        allow read: if request.auth != null && isGroupV2Member();

        // Solo miembros pueden crear mensajes (y deben ser el sender)
        // IMPORTANTE: Si el grupo tiene moderación activa, solo Cloud Functions puede escribir
        allow create: if request.auth != null &&
          isGroupV2Member() &&
          request.auth.uid == request.resource.data.senderId &&
          !groupHasModeration();

        // Solo el sender puede actualizar su mensaje (editar)
        // O miembros pueden actualizar metadata (reactions, readBy)
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.senderId ||
          isGroupV2Member()
        );

        // Solo el sender puede eliminar su mensaje
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.senderId;

        // Favorites subcollection
        match /favorites/{userId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
          allow update: if false;
        }
      }

      // Reactions - Reacciones a mensajes de grupo (subcollection separada)
      match /reactions/{reactionId} {
        // Función para verificar si es miembro del grupo
        function isGroupV2MemberForReactions() {
          let groupDoc = get(/databases/$(database)/documents/groups_v2/$(groupId));
          return request.auth.uid in groupDoc.data.members;
        }

        // Permitir leer reacciones si eres miembro
        allow read: if request.auth != null && isGroupV2MemberForReactions();

        // Permitir crear reacciones si:
        // 1. Eres miembro del grupo, Y
        // 2. El userId en la reacción es tu uid
        allow create: if request.auth != null &&
          isGroupV2MemberForReactions() &&
          request.resource.data.userId == request.auth.uid;

        // Permitir actualizar solo TUS propias reacciones
        allow update: if request.auth != null &&
          isGroupV2MemberForReactions() &&
          resource.data.userId == request.auth.uid;

        // Permitir eliminar solo TUS propias reacciones
        allow delete: if request.auth != null &&
          isGroupV2MemberForReactions() &&
          resource.data.userId == request.auth.uid;
      }

      // Typing indicators
      match /typing/{userId} {
        function isGroupV2MemberForTyping() {
          let groupDoc = get(/databases/$(database)/documents/groups_v2/$(groupId));
          return request.auth.uid in groupDoc.data.members;
        }

        allow read: if request.auth != null && isGroupV2MemberForTyping();
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          isGroupV2MemberForTyping();
      }
    }

    // Group approval requests - Solicitudes de aprobación parental para grupos
    match /group_approval_requests/{requestId} {
      // Solo el parent destinatario puede leer la solicitud
      allow read: if request.auth != null &&
        resource.data.parentId == request.auth.uid;

      // Solo Cloud Functions pueden crear solicitudes
      allow create: if false;

      // Padre puede actualizar sus propias solicitudes (approve/reject)
      // Campos permitidos expandidos para cubrir todos los casos
      function isParentUpdatingOwnRequest() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedFields = ['status', 'respondedAt', 'respondedBy', 'updatedAt', 'processedAt', 'expiresAt'];
        return resource.data.parentId == request.auth.uid &&
               resource.data.status == 'pending' &&
               changedKeys.hasOnly(allowedFields) &&
               (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected');
      }

      allow update: if request.auth != null && isParentUpdatingOwnRequest();

      // Permitir delete al padre (para limpiar después de procesar)
      allow delete: if request.auth != null && resource.data.parentId == request.auth.uid;
    }

    // ============================================================================
    // MOOD POLLS (Encuestas de estado de ánimo para niños)
    // ============================================================================

    // Mood Poll Questions - Preguntas de encuestas
    match /mood_poll_questions/{questionId} {
      // Todos los usuarios autenticados pueden leer las preguntas
      allow read: if request.auth != null;

      // Solo admins/backoffice pueden crear/modificar preguntas
      allow write: if isAdmin();
    }

    // Mood Poll Responses - Respuestas de usuarios
    match /mood_poll_responses/{responseId} {
      // Solo puedes leer tus propias respuestas o las de tus hijos
      function isParentOfResponder() {
        let parentDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return parentDoc.data.linkedChildrenIds != null &&
               resource.data.userId in parentDoc.data.linkedChildrenIds;
      }

      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isParentOfResponder()
      );

      // Solo puedes crear respuestas con tu propio userId
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Solo puedes actualizar tus propias respuestas (ej: marcar como compartida)
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // No permitir eliminar respuestas
      allow delete: if false;
    }

    // Mood Poll Schedules - Control de frecuencia de encuestas por usuario
    match /mood_poll_schedules/{userId} {
      // Solo puedes leer/escribir tu propio schedule
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================================
    // TRIVIAS - Trivias personales en historias
    // ============================================================================

    // Trivias - Colección principal de trivias
    match /trivias/{triviaId} {
      // 🔒 FUNCIÓN: Verificar si el usuario puede ver esta trivia
      // Retorna true si:
      // 1. Es el creador, O
      // 2. Está en availableFor Y no está bloqueado
      function canViewTrivia() {
        let isCreator = request.auth.uid == resource.data.creatorId;
        let isInAvailableFor = request.auth.uid in resource.data.get('availableFor', []);
        let isBlocked = request.auth.uid in resource.data.get('blockedUsers', []);
        return isCreator || (isInAvailableFor && !isBlocked);
      }

      // Permitir leer trivia individual
      allow get: if request.auth != null && canViewTrivia();

      // Permitir listar trivias si el documento cumple canViewTrivia
      // Las queries DEBEN filtrar por creatorId O availableFor para que funcione
      allow list: if request.auth != null && canViewTrivia();

      // Solo puedes crear trivias con tu propio creatorId
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid;

      // 🔒 FUNCIÓN: Verificar si solo se actualizan campos permitidos (creador)
      function isUpdatingAllowedCreatorFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let allowedCreatorFields = ['title', 'backgroundImageUrl', 'updatedAt', 'status', 'closedAt', 'resultsStoryId', 'participantCount', 'hasResponses', 'reminderSent'];
        return changedKeys.hasOnly(allowedCreatorFields);
      }

      // 🔒 FUNCIÓN: Verificar si solo se actualizan campos de participación
      function isUpdatingParticipationFields() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        // Campos que cualquier participante puede actualizar
        let allowedFields = ['participantCount', 'hasResponses'];
        return changedKeys.hasOnly(allowedFields);
      }

      // 🔒 FUNCIÓN: Verificar si la trivia tiene respuestas (inmutable)
      function triviaHasNoResponses() {
        return resource.data.get('hasResponses', false) == false;
      }

      // Permitir actualizar si:
      // 1. Eres el creador Y (no hay respuestas O solo actualizas campos permitidos), O
      // 2. Eres participante Y solo actualizas campos de participación
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.creatorId &&
         (triviaHasNoResponses() || isUpdatingAllowedCreatorFields())) ||
        (canViewTrivia() && isUpdatingParticipationFields())
      );

      // Solo el creador puede eliminar
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.creatorId;

      // Subcolección de preguntas
      match /questions/{questionId} {
        // 🔒 FUNCIÓN: Verificar si el usuario puede ver las preguntas de esta trivia
        function canViewTriviaQuestions() {
          let triviaDoc = get(/databases/$(database)/documents/trivias/$(triviaId));
          let isCreator = request.auth.uid == triviaDoc.data.creatorId;
          let isAvailable = triviaDoc.data.availableFor != null &&
                            request.auth.uid in triviaDoc.data.availableFor;
          let isBlocked = triviaDoc.data.blockedUsers != null &&
                          request.auth.uid in triviaDoc.data.blockedUsers;
          return isCreator || (isAvailable && !isBlocked) || !isBlocked;
        }

        // 🔒 FUNCIÓN: Verificar si el usuario es creador de la trivia
        function isTriviaCreator() {
          let triviaDoc = get(/databases/$(database)/documents/trivias/$(triviaId));
          return request.auth.uid == triviaDoc.data.creatorId;
        }

        // Permitir leer preguntas si puedes ver la trivia
        allow read: if request.auth != null && canViewTriviaQuestions();

        // Solo el creador puede crear preguntas (y solo si no hay respuestas)
        allow create: if request.auth != null && isTriviaCreator();

        // Solo el creador puede actualizar preguntas
        allow update: if request.auth != null && isTriviaCreator();

        // Solo el creador puede eliminar preguntas
        allow delete: if request.auth != null && isTriviaCreator();
      }
    }

    // Trivia Responses - Respuestas a trivias
    // ID format: {oderId}_{triviaId}
    match /trivia_responses/{responseId} {
      // 🔒 FUNCIÓN: Verificar si el responseId pertenece al usuario actual
      // El formato es oderId_triviaId, así que verificamos que empiece con nuestro uid
      function isOwnResponseId() {
        return responseId.matches(request.auth.uid + '_.*');
      }

      // 🔒 FUNCIÓN: Verificar si el usuario puede ver esta respuesta (cuando existe)
      function canViewTriviaResponse() {
        // El respondedor puede ver su propia respuesta
        let isResponder = resource.data.oderId == request.auth.uid;

        // El creador de la trivia puede ver todas las respuestas
        let triviaDoc = get(/databases/$(database)/documents/trivias/$(resource.data.triviaId));
        let isTriviaCreator = triviaDoc.data.creatorId == request.auth.uid;

        return isResponder || isTriviaCreator;
      }

      // 🔒 FUNCIÓN: Verificar si la trivia está activa
      function isTriviaActive() {
        let triviaDoc = get(/databases/$(database)/documents/trivias/$(request.resource.data.triviaId));
        return triviaDoc.data.status == 'active';
      }

      // 🔒 FUNCIÓN: Verificar si el usuario puede responder la trivia
      function canRespondToTrivia() {
        let triviaDoc = get(/databases/$(database)/documents/trivias/$(request.resource.data.triviaId));
        // No puede ser el creador
        let isNotCreator = triviaDoc.data.creatorId != request.auth.uid;
        // No puede estar bloqueado
        let isNotBlocked = !(request.auth.uid in triviaDoc.data.get('blockedUsers', []));
        // Debe estar en availableFor
        let canAccess = request.auth.uid in triviaDoc.data.get('availableFor', []);
        return isNotCreator && isNotBlocked && canAccess;
      }

      // Permitir leer (get) si:
      // 1. El responseId empieza con tu userId (para verificar existencia), O
      // 2. El documento existe y puedes verlo
      allow get: if request.auth != null && (
        isOwnResponseId() ||
        canViewTriviaResponse()
      );

      // Permitir listar si:
      // 1. Eres el respondedor de la respuesta, O
      // 2. Eres el creador de la trivia, O
      // 3. Puedes ver la trivia (para leaderboard público)
      allow list: if request.auth != null;

      // Permitir crear respuesta si:
      // 1. El oderId es tu propio uid, Y
      // 2. La trivia está activa, Y
      // 3. Puedes responder (no eres creador, no estás bloqueado)
      allow create: if request.auth != null &&
        request.resource.data.oderId == request.auth.uid &&
        isTriviaActive() &&
        canRespondToTrivia();

      // Permitir actualizar solo tu propia respuesta (para guardar progreso)
      allow update: if request.auth != null &&
        resource.data.oderId == request.auth.uid;

      // Permitir eliminar respuestas si:
      // 1. Eres el creador de la trivia (para cuando elimina la trivia completa), O
      // 2. Eres el dueño de la respuesta (para eliminar tu propia respuesta)
      allow delete: if request.auth != null && canViewTriviaResponse();
    }

    // ============================================================================
    // COLLECTION GROUP QUERIES
    // ============================================================================
    // Reglas para queries usando collectionGroup() que atraviesan múltiples chats

    // Messages - Queries globales de mensajes usando collectionGroup()
    // Esto captura tanto /chats/{chatId}/messages como /groups/{groupId}/messages
    match /{chatOrGroup}/{chatId}/messages/{messageId} {
      // Función para verificar si el usuario es participante del chat/grupo padre
      function isParticipantOfParent() {
        // Si es un chat 1-1 (en /chats/)
        return (chatOrGroup == 'chats' &&
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
               // Si es un grupo (en /groups/)
               (chatOrGroup == 'groups' &&
                request.auth.uid in get(/databases/$(database)/documents/groups/$(chatId)).data.members);
      }

      // Permitir leer mensajes individuales si eres participante del chat/grupo padre
      allow get: if request.auth != null && isParticipantOfParent();

      // ⚡ GLOBAL MESSAGE LISTENER: Permitir queries solo si eres participante
      // 🔒 SEGURIDAD: Validación SERVER-SIDE - el usuario DEBE ser participante del chat/grupo
      allow list: if request.auth != null && isParticipantOfParent();
    }
  }
}
