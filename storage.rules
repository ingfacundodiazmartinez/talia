rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 🔒 SECURE STORAGE RULES - USER DATA PROTECTION
    // ⚠️ IMPORTANTE: Los paths deben coincidir EXACTAMENTE con los del código Flutter

    // ═══════════════════════════════════════════════════════════════
    // PROFILE IMAGES
    // Path real: profile_images/{userId}.jpg (sin subcarpeta)
    // ═══════════════════════════════════════════════════════════════
    match /profile_images/{fileName} {
      // Extraer userId del fileName (formato: userId.jpg)
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && isValidImage()
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // CHAT MEDIA (imágenes, videos)
    // Path real: chat_media/{mediaType}/{chatId}/{fileName}
    // mediaType = images, videos, audio, files
    // ═══════════════════════════════════════════════════════════════
    match /chat_media/{mediaType}/{chatId}/{fileName} {
      allow read: if request.auth != null
                  && isParticipant(chatId, request.auth.uid);
      allow write: if request.auth != null
                   && isParticipant(chatId, request.auth.uid)
                   && isValidMediaFile()
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // CHAT AUDIOS (mensajes de voz)
    // Path real: chats/{chatId}/audios/{fileName}
    // ═══════════════════════════════════════════════════════════════
    match /chats/{chatId}/audios/{fileName} {
      allow read: if request.auth != null
                  && isParticipant(chatId, request.auth.uid);
      allow write: if request.auth != null
                   && isParticipant(chatId, request.auth.uid)
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // STORIES
    // Path real: stories/{userId}/{storyId}/{fileName}
    // ═══════════════════════════════════════════════════════════════
    match /stories/{userId}/{storyId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || canViewStory(userId, request.auth.uid));
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isValidMediaFile()
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // TEMP TRANSFORMS (DeepAR, filtros)
    // Path real: temp_transforms/{fileName}
    // ═══════════════════════════════════════════════════════════════
    match /temp_transforms/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // GROUP AVATARS
    // Solo miembros aprobados del grupo pueden ver/modificar
    // ═══════════════════════════════════════════════════════════════

    // Path: group_avatars/{groupId}.jpg - groupId está en el fileName
    match /group_avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Path: group_images/{groupId}_{timestamp}.jpg
    match /group_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // GROUPS V2 CONTENT (images, audios, avatars for group chats)
    // Path: groups_v2/{groupId}/{userId}/{mediaType}/{fileName}
    // Seguridad: Solo el usuario autenticado puede escribir en su carpeta
    // ═══════════════════════════════════════════════════════════════
    match /groups_v2/{groupId}/{userId}/{mediaType}/{fileName} {
      // READ: Cualquier autenticado (membresía se verifica en app)
      allow read: if request.auth != null;
      // WRITE: Solo el dueño de la carpeta userId
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Path alternativo: groups_v2/{groupId}/{userId}/{fileName} (avatars)
    match /groups_v2/{groupId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Legacy: grupos sin userId en path (solo lectura para compatibilidad)
    match /groups_v2/{groupId}/{mediaType}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false; // Bloquear escritura en path antiguo
    }

    // ═══════════════════════════════════════════════════════════════
    // TRIVIAS
    // Path: trivia_backgrounds/{userId}/{fileName}
    // Path: trivia_questions/{userId}/{fileName}
    // ═══════════════════════════════════════════════════════════════
    match /trivia_backgrounds/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isValidImage()
                   && request.resource.size < 10 * 1024 * 1024;
    }

    match /trivia_questions/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isValidImage()
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // LEGACY PATHS (compatibilidad con datos existentes)
    // ═══════════════════════════════════════════════════════════════

    // Audio messages legacy path
    match /audio_messages/{chatId}/{fileName} {
      allow read: if request.auth != null
                  && isParticipant(chatId, request.auth.uid);
      allow write: if request.auth != null
                   && isParticipant(chatId, request.auth.uid)
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Documents legacy path
    match /documents/{chatId}/{fileName} {
      allow read: if request.auth != null
                  && isParticipant(chatId, request.auth.uid);
      allow write: if request.auth != null
                   && isParticipant(chatId, request.auth.uid)
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Temp files legacy path
    match /temp/{userId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // ═══════════════════════════════════════════════════════════════
    // CATCH-ALL: Deny everything else
    // ═══════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // 🛡️ SECURITY FUNCTIONS
    // ═══════════════════════════════════════════════════════════════

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.contentType in [
               'image/jpeg', 'image/png', 'image/gif', 'image/webp',
               'image/heic', 'image/heif', 'image/bmp', 'image/tiff', 'image/avif'
             ];
    }

    function isValidMediaFile() {
      return request.resource.contentType in [
               // Images
               'image/jpeg', 'image/png', 'image/gif', 'image/webp',
               'image/heic', 'image/heif', 'image/bmp', 'image/tiff', 'image/avif',
               // Videos
               'video/mp4', 'video/mov', 'video/avi', 'video/webm', 'video/quicktime'
             ];
    }

    function isParticipant(chatId, userId) {
      // For individual chats: chatId format is "userId1_userId2" (sorted)
      // Check if userId is part of the chatId string
      return chatId.matches(userId + '_.*') || chatId.matches('.*_' + userId);
    }

    function canViewStory(storyUserId, viewerId) {
      return storyUserId == viewerId || isApprovedContact(storyUserId, viewerId);
    }

    function isApprovedContact(profileUserId, viewerId) {
      return profileUserId == viewerId ? true : checkContactApproval(profileUserId, viewerId);
    }

    function checkContactApproval(profileUserId, viewerId) {
      let contactDocId = profileUserId < viewerId ?
                        profileUserId + '_' + viewerId :
                        viewerId + '_' + profileUserId;

      let contactDoc = firestore.get(/databases/(default)/documents/contacts/$(contactDocId));

      return contactDoc != null &&
             contactDoc.data != null &&
             contactDoc.data.users != null &&
             profileUserId in contactDoc.data.users &&
             viewerId in contactDoc.data.users &&
             (!('status' in contactDoc.data) || contactDoc.data.status != 'blocked');
    }
  }
}
